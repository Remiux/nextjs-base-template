# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser; keep secrets without that prefix.
# Every variable is validated in src/env.ts — add new ones there too.

# Public URL of the app. Used for metadata, robots.txt and the sitemap.
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only variables (never prefixed with NEXT_PUBLIC_), validated in src/env.server.ts.
# EXAMPLE_API_KEY=
